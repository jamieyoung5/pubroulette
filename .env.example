GEOAPIFY_API_KEY=
REDIS_URL=redis://localhost:6379

# 32+ random bytes, base64-encoded. Signs room session tokens.
# Generate with: openssl rand -base64 32
ROOM_TOKEN_SECRET=

# Optional. During a rotation, set this to the previous ROOM_TOKEN_SECRET so
# tokens signed before it stay valid until they expire. Remove once
# auth_token_verified_with_previous_secret stops appearing in the logs.
# ROOM_TOKEN_SECRET_PREVIOUS=

# Optional. Nominatim endpoint for /api/search. Defaults to the public service;
# point it at a mirror if you outgrow their usage policy.
# NOMINATIM_BASE_URL=

# Optional. Set to 1 to bypass the places cache and always call upstream.
# PLACES_CACHE_DISABLED=
